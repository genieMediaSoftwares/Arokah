# ─── Secrets ──────────────────────────────────────────────────────────────────
# Every environment file, everywhere, at any depth. There are no tracked
# templates: the required variables are validated at boot by
# backend/src/config/env.js and documented in backend/README.md.
.env
*.env
.env.*
**/.env
**/*.env
**/.env.*

# ─── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
**/node_modules/

# ─── Build output ─────────────────────────────────────────────────────────────
dist/
dist-ssr/
build/
*.local

# ─── User uploads ─────────────────────────────────────────────────────────────
# Ignore the CONTENTS, not the directory itself — git cannot re-include a file
# whose parent directory is excluded, so `uploads/` would also hide .gitkeep.
uploads/*
backend/uploads/*
!backend/uploads/.gitkeep

# ─── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─── Migration artefacts ──────────────────────────────────────────────────────
# Firebase JSON exports contain production data — keep them out of git.
firebase-export*.json
*-rtdb-export.json

# ─── Editor / OS ──────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ─── Test coverage ────────────────────────────────────────────────────────────
coverage/
.nyc_output/
